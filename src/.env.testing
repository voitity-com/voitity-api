APP_ENV=testing
APP_DEBUG=true

# Database Configuration - SQLite for testing
DB_CONNECTION=sqlite
DB_DATABASE=:memory:

# Cache & Session - Use arrays for testing
CACHE_DRIVER=array
QUEUE_CONNECTION=sync
PAYMENTS_USD_COP_RATE_DRIVER=config
PAYMENTS_USD_COP_RATE_FALLBACK_DRIVER=config
SESSION_DRIVER=array
MAIL_MAILER=array

# Disable broadcasting during tests
BROADCAST_DRIVER=log
